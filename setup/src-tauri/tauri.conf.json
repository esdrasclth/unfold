{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar Unfold",
  "version": "0.5.3",
  "identifier": "com.esdras.unfold.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Instalar Unfold",
        "width": 940,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Esdras Clother - BrandSofts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
