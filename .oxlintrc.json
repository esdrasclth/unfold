{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "node_modules", "src-tauri", "setup", "web"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "env": { "node": true, "browser": false }
    }
  ]
}
