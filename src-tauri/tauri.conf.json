{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfold",
  "version": "0.2.0",
  "identifier": "com.esdras.unfold",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unfold",
        "width": 1080,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": true,
        "theme": null,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Esdras Clother",
    "shortDescription": "Editor Markdown con vista previa en vivo",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true,
    "homepage": "https://github.com/esdrasclth/unfold"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/esdrasclth/unfold/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MkQ5QzQyRUUwODJFMTYKUldRV0xnanVRcHd0MTBSM1hOb1FzMjF3QXJOWVI4c0JjZ2RVcENLa3lvRTRxNm9kYk5aOXo3MzkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
